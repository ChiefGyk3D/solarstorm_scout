# SolarStorm Scout Configuration
# Copy this file to .env and fill in your credentials

# =============================================================================
# GENERAL SETTINGS
# =============================================================================

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Posting interval in hours (default: 1.5)
# This is only used for documentation - actual interval set during systemd install
POSTING_INTERVAL_HOURS=1.5

# =============================================================================
# BLUESKY CONFIGURATION
# =============================================================================

# Enable Bluesky posting (true/false)
# (BLUESKY_ENABLED, the original name of this switch, still works)
BLUESKY_ENABLE_POSTING=false

# Bluesky handle (e.g., username.bsky.social)
BLUESKY_HANDLE=

# Bluesky app password (generate at: https://bsky.app/settings/app-passwords)
# DO NOT use your main account password!
BLUESKY_APP_PASSWORD=

# =============================================================================
# MASTODON CONFIGURATION
# =============================================================================

# Enable Mastodon posting (true/false)
# (MASTODON_ENABLED, the original name of this switch, still works)
MASTODON_ENABLE_POSTING=false

# Mastodon instance URL (e.g., https://mastodon.social)
MASTODON_API_BASE_URL=

# Mastodon access token (from Preferences -> Development -> New Application)
MASTODON_ACCESS_TOKEN=

# Optional: Mastodon client credentials (usually not needed; the access token is enough)
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=

# =============================================================================
# ON-AIR BRIEFING — LLM (OPTIONAL)
# =============================================================================

# When enabled, a local LLM opens each thread with a short "radio weatherperson"
# read of the numbers. It is checked against the data before it goes out; if it
# fails the checks, or the server is down, the thread is posted without it.
# Same settings as Boon-Tube-Daemon and stream-daemon (they share hypeman-social).
LLM_ENABLE=false

# Provider: ollama (local, default here) or gemini (cloud, needs GEMINI_API_KEY
# and `pip install "hypeman-social[gemini]"`)
LLM_PROVIDER=ollama

# Your Ollama server. The port is only appended when the host has none.
LLM_OLLAMA_HOST=http://localhost
LLM_OLLAMA_PORT=11434
LLM_OLLAMA_MODEL=gemma3:4b

# Opt-in failover when the primary is down, e.g. gemini. Leave empty to keep
# everything on your own network: an Ollama outage then costs the briefing,
# not your privacy.
LLM_FALLBACK_PROVIDER=

# Generation and guardrail knobs (defaults shown; full list in hypeman-social's
# docs/CONFIGURATION.md)
#LLM_TEMPERATURE=0.3
#LLM_MAX_EMOJI_COUNT=2
#LLM_ENABLE_PROFANITY_FILTER=false
#LLM_ENABLE_THINKING_MODE=false

# =============================================================================
# DOPPLER SECRETS MANAGER (OPTIONAL)
# =============================================================================

# If using Doppler for secrets management, ALL THREE variables are required:
# Get token from: https://dashboard.doppler.com/
DOPPLER_TOKEN=
DOPPLER_PROJECT=          # Example: solarstorm-scout
DOPPLER_CONFIG=           # Example: prd, dev, or staging

# =============================================================================
# NOTES
# =============================================================================

# IMPORTANT: Space weather conditions can change rapidly. The bot posts current
# conditions at the time of each run. For real-time updates, visit NOAA SWPC:
# https://www.swpc.noaa.gov/

# Bluesky Setup:
# 1. Go to https://bsky.app/settings/app-passwords
# 2. Create a new app password with a descriptive name (e.g., "SolarStorm Scout")
# 3. Copy the generated password to BLUESKY_APP_PASSWORD above
# 4. Your handle is your full username including the domain (e.g., alice.bsky.social)

# Mastodon Setup:
# 1. Log into your Mastodon instance
# 2. Go to Preferences -> Development -> New Application
# 3. Give it a name (e.g., "SolarStorm Scout")
# 4. Scopes needed: read, write:statuses, write:media
#    - read: Verify account credentials
#    - write:statuses: Post status updates and threads
#    - write:media: Upload images to posts
# 5. Save and copy the "Your access token" to MASTODON_ACCESS_TOKEN above
# 6. The API base URL is your instance URL (e.g., https://mastodon.social)
# 7. Client ID and Secret are optional (usually not needed with access token)

# Doppler Setup (Optional):
# 1. Create a Doppler account at https://doppler.com
# 2. Create a project for SolarStorm Scout (e.g., "solarstorm-scout")
# 3. Create a config within the project (e.g., "dev", "prd")
# 4. Add your credentials as Doppler secrets:
#    - BLUESKY_HANDLE
#    - BLUESKY_APP_PASSWORD
#    - MASTODON_API_BASE_URL
#    - MASTODON_ACCESS_TOKEN
# 5. Generate a service token from Doppler dashboard
# 6. Set DOPPLER_TOKEN, DOPPLER_PROJECT, and DOPPLER_CONFIG in .env
# 7. Doppler values will override .env values for any matching keys
# AWS Secrets Manager (SECRETS_MANAGER=aws) and HashiCorp Vault
# (SECRETS_MANAGER=vault) are supported too through hypeman-social.

# LLM Setup (Optional):
# 1. Run Ollama on a machine on your network: https://ollama.com
# 2. ollama pull gemma3:4b   (or any model you like; set LLM_OLLAMA_MODEL)
# 3. Set LLM_ENABLE=true and LLM_OLLAMA_HOST above
# 4. Preview without posting: python3 -m solarstorm_scout.demo

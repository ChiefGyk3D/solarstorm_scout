# Development and CI-only dependencies: the test runner and the linter. They
# are kept out of requirements.in so the container image never carries them.
# requirements-dev.txt is generated from this file with every transitive
# dependency pinned and hashed; regenerate it after editing here:
#
#   pip install uv
#   uv pip compile requirements-dev.in --universal --generate-hashes --python-version 3.11 -o requirements-dev.txt
#
# This lock is a superset of the runtime lock: it pulls requirements.in in so
# a development environment matches what the image runs.

-r requirements.in

pytest==9.1.1
ruff==0.15.8
